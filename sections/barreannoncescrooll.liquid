{% style %}
  #Marquee-{{ section.id }} {
    --marquee-bg: {{ section.settings.background_color }};
    --marquee-text: {{ section.settings.text_color }};
    --marquee-square: {{ section.settings.separator_color }};
    --marquee-font-desktop: {{ section.settings.font_size_desktop }}px;
    --marquee-font-mobile: {{ section.settings.font_size_mobile }}px;
    --marquee-gap-desktop: {{ section.settings.gap_desktop }}px;
    --marquee-gap-mobile: {{ section.settings.gap_mobile }}px;
    --marquee-speed-desktop: {{ section.settings.speed_desktop }}s;
    --marquee-speed-mobile: {{ section.settings.speed_mobile }}s;

    background: var(--marquee-bg);
    color: var(--marquee-text);
    width: 100%;
    overflow: hidden;
  }

  #Marquee-{{ section.id }} .marquee__viewport {
    width: 100%;
    overflow: hidden;
    padding: {{ section.settings.padding_vertical }}px 0;
  }

  #Marquee-{{ section.id }} .marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    animation: marquee-scroll-{{ section.id }}
      var(--marquee-speed-desktop)
      linear
      infinite;
  }

  #Marquee-{{ section.id }} .marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
  }

  #Marquee-{{ section.id }} .marquee__item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding-left: var(--marquee-gap-desktop);
    padding-right: var(--marquee-gap-desktop);

    font-size: var(--marquee-font-desktop);
    line-height: 1.2;
    font-weight: {{ section.settings.font_weight }};
    letter-spacing: {{ section.settings.letter_spacing | divided_by: 100.0 }}em;
    text-decoration: none;
    color: var(--marquee-text);

    {% if section.settings.uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  #Marquee-{{ section.id }} .marquee__item:hover {
    color: var(--marquee-text);
    opacity: 0.7;
  }

  #Marquee-{{ section.id }} .marquee__separator {
    width: {{ section.settings.separator_size }}px;
    height: {{ section.settings.separator_size }}px;
    background: var(--marquee-square);
    display: block;
    flex: 0 0 auto;
    border-radius: {{ section.settings.separator_radius }}px;
  }

  {% if section.settings.pause_on_hover %}
    #Marquee-{{ section.id }}:hover .marquee__track {
      animation-play-state: paused;
    }
  {% endif %}

  @keyframes marquee-scroll-{{ section.id }} {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    #Marquee-{{ section.id }} .marquee__viewport {
      padding: {{ section.settings.padding_vertical_mobile }}px 0;
    }

    #Marquee-{{ section.id }} .marquee__track {
      animation-duration: var(--marquee-speed-mobile);
    }

    #Marquee-{{ section.id }} .marquee__item {
      font-size: var(--marquee-font-mobile);
      padding-left: var(--marquee-gap-mobile);
      padding-right: var(--marquee-gap-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #Marquee-{{ section.id }} .marquee__track {
      animation-play-state: paused;
    }
  }
{% endstyle %}


<section
  id="Marquee-{{ section.id }}"
  class="marquee-section"
>
  <div class="marquee__viewport">
    <div class="marquee__track">

      <!-- PREMIER GROUPE -->
      <div class="marquee__group">
        {% for repeat in (1..3) %}
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}

              {% if block.settings.link != blank %}
                <a
                  href="{{ block.settings.link }}"
                  class="marquee__item"
                  {% if repeat == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  {{ block.settings.text }}
                </a>
              {% else %}
                <span
                  class="marquee__item"
                  {% if repeat == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  {{ block.settings.text }}
                </span>
              {% endif %}

              <span
                class="marquee__separator"
                aria-hidden="true"
              ></span>

            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>


      <!-- COPIE POUR LE DÉFILEMENT INFINI -->
      <div
        class="marquee__group"
        aria-hidden="true"
      >
        {% for repeat in (1..3) %}
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}

              <span class="marquee__item">
                {{ block.settings.text }}
              </span>

              <span
                class="marquee__separator"
                aria-hidden="true"
              ></span>

            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>


{% schema %}
{
  "name": "Barre annonce défilante",
  "tag": "section",
  "class": "section-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur du fond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#47444A"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Couleur des carrés",
      "default": "#47444A"
    },

    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Taille texte PC",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Taille texte mobile",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Épaisseur du texte",
      "default": "400",
      "options": [
        {
          "value": "300",
          "label": "Fin"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "label": "Espacement des lettres",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Texte en majuscules",
      "default": true
    },

    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Espacement PC",
      "default": 34
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Espacement mobile",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Hauteur intérieure PC",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 5,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Hauteur intérieure mobile",
      "default": 12
    },

    {
      "type": "header",
      "content": "Séparateur"
    },
    {
      "type": "range",
      "id": "separator_size",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Taille du carré",
      "default": 7
    },
    {
      "type": "range",
      "id": "separator_radius",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Arrondi du carré",
      "default": 1
    },

    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "speed_desktop",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "s",
      "label": "Vitesse PC",
      "default": 35
    },
    {
      "type": "range",
      "id": "speed_mobile",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "s",
      "label": "Vitesse mobile",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause au survol",
      "default": false
    }
  ],

  "blocks": [
    {
      "type": "item",
      "name": "Texte",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "NOUVELLE COLLECTION"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien facultatif"
        }
      ]
    }
  ],

  "max_blocks": 15,

  "presets": [
    {
      "name": "Barre annonce défilante",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "ÉLÉGANTE"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "OBJETS DESIGN"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "MAROQUINERIE"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "CAVE À CIGARES"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "BRACELETS"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "PRODUITS PERSONNALISABLES"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "ÉTUI À CIGARE"
          }
        }
      ]
    }
  ]
}
{% endschema %}