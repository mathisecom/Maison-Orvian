{% style %}

  #OrvinBrands-{{ section.id }} {
    --brands-bg: {{ section.settings.background_color }};
    --brands-text: {{ section.settings.text_color }};
    --brands-max-width: {{ section.settings.max_width }}px;
    --brands-logo-height: {{ section.settings.logo_height }}px;
    --brands-logo-opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
    --brands-gap: {{ section.settings.logo_gap }}px;

    width: 100%;
    background: var(--brands-bg);
    color: var(--brands-text);
    overflow: hidden;
    font-family: inherit;
  }

  #OrvinBrands-{{ section.id }} * {
    box-sizing: border-box;
  }

  #OrvinBrands-{{ section.id }} .orvin-brands__container {
    width: 100%;
    max-width: var(--brands-max-width);
    margin: 0 auto;

    padding:
      {{ section.settings.padding_top }}px
      30px
      {{ section.settings.padding_bottom }}px;
  }


  /* =============================
     TITRE
  ============================== */

  #OrvinBrands-{{ section.id }} .orvin-brands__header {
    max-width: 650px;
    margin: 0 auto {{ section.settings.title_bottom_spacing }}px;
    text-align: center;
  }

  #OrvinBrands-{{ section.id }} .orvin-brands__title {
    margin: 0;

    color: var(--brands-text);

    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: {{ section.settings.title_weight }};

    font-size: {{ section.settings.title_size }}px;
    line-height: 1.25;

    letter-spacing: -0.02em;
  }


  /* =============================
     LOGOS
  ============================== */

  #OrvinBrands-{{ section.id }} .orvin-brands__logos {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: var(--brands-gap);

    width: 100%;
  }

  #OrvinBrands-{{ section.id }} .orvin-brands__item {
    flex: 1 1 0;

    min-width: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    text-decoration: none;
  }

  #OrvinBrands-{{ section.id }} .orvin-brands__logo-wrapper {
    width: 100%;
    height: {{ section.settings.logo_area_height }}px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  #OrvinBrands-{{ section.id }} .orvin-brands__logo {
    display: block;

    width: auto;
    max-width: {{ section.settings.logo_max_width }}px;

    height: auto;
    max-height: var(--brands-logo-height);

    object-fit: contain;

    opacity: var(--brands-logo-opacity);

    transition:
      opacity .3s ease,
      transform .3s ease;
  }

  #OrvinBrands-{{ section.id }} .orvin-brands__item:hover .orvin-brands__logo {
    opacity: 1;
    transform: scale(1.03);
  }


  /* TEXTE SI AUCUN LOGO N'EST CHARGÉ */

  #OrvinBrands-{{ section.id }} .orvin-brands__placeholder {
    margin: 0;

    color: var(--brands-text);

    font-family: inherit;
    font-size: 13px;
    font-weight: 500;

    text-align: center;
    text-transform: uppercase;
    letter-spacing: .06em;

    opacity: var(--brands-logo-opacity);
  }


  /* =============================
     TABLETTE
  ============================== */

  @media screen and (max-width: 990px) {

    #OrvinBrands-{{ section.id }} .orvin-brands__container {
      padding-left: 24px;
      padding-right: 24px;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__logos {
      gap: 35px;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__logo {
      max-width: 130px;
    }

  }


  /* =============================
     MOBILE
  ============================== */

  @media screen and (max-width: 749px) {

    #OrvinBrands-{{ section.id }} .orvin-brands__container {
      padding:
        {{ section.settings.padding_top_mobile }}px
        0
        {{ section.settings.padding_bottom_mobile }}px;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__header {
      max-width: 340px;

      margin-bottom:
        {{ section.settings.title_bottom_spacing_mobile }}px;

      padding: 0 20px;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__title {
      font-size: {{ section.settings.title_size_mobile }}px;
      line-height: 1.3;
    }


    /* DÉFILEMENT HORIZONTAL MOBILE */

    #OrvinBrands-{{ section.id }} .orvin-brands__logos {
      justify-content: flex-start;

      gap: {{ section.settings.logo_gap_mobile }}px;

      overflow-x: auto;

      padding:
        0
        20px
        6px;

      scroll-snap-type: x proximity;
      scroll-padding-left: 20px;

      scrollbar-width: none;
      -ms-overflow-style: none;

      -webkit-overflow-scrolling: touch;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__logos::-webkit-scrollbar {
      display: none;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__item {
      flex:
        0
        0
        {{ section.settings.mobile_logo_width }}px;

      scroll-snap-align: start;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__logo-wrapper {
      height: {{ section.settings.logo_area_height_mobile }}px;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__logo {
      max-width: {{ section.settings.logo_max_width_mobile }}px;
      max-height: {{ section.settings.logo_height_mobile }}px;
    }

    #OrvinBrands-{{ section.id }} .orvin-brands__placeholder {
      font-size: 11px;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    #OrvinBrands-{{ section.id }} .orvin-brands__logo {
      transition: none;
    }

  }

{% endstyle %}



<section
  id="OrvinBrands-{{ section.id }}"
  class="orvin-brands"
>

  <div class="orvin-brands__container">


    {% if section.settings.title != blank %}

      <div class="orvin-brands__header">

        <h2 class="orvin-brands__title">
          {{ section.settings.title }}
        </h2>

      </div>

    {% endif %}



    {% if section.blocks.size > 0 %}

      <div class="orvin-brands__logos">


        {% for block in section.blocks %}


          {% if block.settings.link != blank %}

            <a
              href="{{ block.settings.link }}"
              class="orvin-brands__item"
              aria-label="{{ block.settings.name | escape }}"
              {{ block.shopify_attributes }}
            >

          {% else %}

            <div
              class="orvin-brands__item"
              {{ block.shopify_attributes }}
            >

          {% endif %}


              <div class="orvin-brands__logo-wrapper">


                {% if block.settings.logo != blank %}

                  {{
                    block.settings.logo
                    | image_url: width: 500
                    | image_tag:
                      class: 'orvin-brands__logo',
                      loading: 'lazy',
                      widths: '120, 180, 240, 320, 400, 500',
                      sizes: '(max-width: 749px) 140px, 180px',
                      alt: block.settings.name
                  }}


                {% elsif block.settings.name != blank %}

                  <p class="orvin-brands__placeholder">
                    {{ block.settings.name }}
                  </p>

                {% endif %}


              </div>


          {% if block.settings.link != blank %}

            </a>

          {% else %}

            </div>

          {% endif %}


        {% endfor %}


      </div>

    {% endif %}


  </div>

</section>



{% schema %}
{
  "name": "Maison Orvin - Marques",
  "tag": "section",
  "class": "section-orvin-brands",

  "settings": [

    {
      "type": "header",
      "content": "Contenu"
    },

    {
      "type": "textarea",
      "id": "title",
      "label": "Titre",
      "default": "Compatibles avec les plus grandes maisons horlogères."
    },


    {
      "type": "header",
      "content": "Couleurs"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#1A1A1A"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#FFFFFF"
    },


    {
      "type": "header",
      "content": "Section ordinateur"
    },

    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Largeur maximale",
      "default": 1400
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espacement supérieur",
      "default": 68
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Espacement inférieur",
      "default": 72
    },


    {
      "type": "header",
      "content": "Titre ordinateur"
    },

    {
      "type": "range",
      "id": "title_size",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Taille du titre",
      "default": 26
    },

    {
      "type": "select",
      "id": "title_weight",
      "label": "Épaisseur du titre",
      "default": "500",
      "options": [
        {
          "value": "300",
          "label": "Fin"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Moyen"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        }
      ]
    },

    {
      "type": "range",
      "id": "title_bottom_spacing",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espace entre titre et logos",
      "default": 68
    },


    {
      "type": "header",
      "content": "Logos ordinateur"
    },

    {
      "type": "range",
      "id": "logo_gap",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Espacement entre logos",
      "default": 46
    },

    {
      "type": "range",
      "id": "logo_max_width",
      "min": 60,
      "max": 240,
      "step": 5,
      "unit": "px",
      "label": "Largeur maximale des logos",
      "default": 150
    },

    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Hauteur maximale des logos",
      "default": 46
    },

    {
      "type": "range",
      "id": "logo_area_height",
      "min": 40,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Hauteur de la zone logo",
      "default": 80
    },

    {
      "type": "range",
      "id": "logo_opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacité des logos",
      "default": 65
    },


    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacement supérieur mobile",
      "default": 48
    },

    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacement inférieur mobile",
      "default": 48
    },

    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Taille titre mobile",
      "default": 21
    },

    {
      "type": "range",
      "id": "title_bottom_spacing_mobile",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espace titre / logos mobile",
      "default": 44
    },

    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 90,
      "max": 220,
      "step": 5,
      "unit": "px",
      "label": "Largeur emplacement logo mobile",
      "default": 135
    },

    {
      "type": "range",
      "id": "logo_gap_mobile",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Espacement logos mobile",
      "default": 26
    },

    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "px",
      "label": "Largeur maximale logo mobile",
      "default": 115
    },

    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Hauteur maximale logo mobile",
      "default": 38
    },

    {
      "type": "range",
      "id": "logo_area_height_mobile",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Hauteur zone logo mobile",
      "default": 70
    }

  ],


  "blocks": [

    {
      "type": "brand",
      "name": "Marque",
      "settings": [

        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },

        {
          "type": "text",
          "id": "name",
          "label": "Nom / texte alternatif",
          "default": "Maison horlogère"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Lien facultatif"
        }

      ]
    }

  ],

  "max_blocks": 10,


  "presets": [

    {
      "name": "Maison Orvin - Marques",
      "blocks": [

        {
          "type": "brand",
          "settings": {
            "name": "Maison 1"
          }
        },

        {
          "type": "brand",
          "settings": {
            "name": "Maison 2"
          }
        },

        {
          "type": "brand",
          "settings": {
            "name": "Maison 3"
          }
        },

        {
          "type": "brand",
          "settings": {
            "name": "Maison 4"
          }
        },

        {
          "type": "brand",
          "settings": {
            "name": "Maison 5"
          }
        },

        {
          "type": "brand",
          "settings": {
            "name": "Maison 6"
          }
        }

      ]
    }

  ]

}
{% endschema %}